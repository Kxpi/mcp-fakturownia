# REQUIRED
FAKTUROWNIA_BASE_URL=https://YOUR_SUBDOMAIN.fakturownia.pl
FAKTUROWNIA_API_TOKEN=your_api_token_here

# OPTIONAL
CEIDG_API_TOKEN=                  # Optional fallback for lookup_company_by_nip when NIP was never VAT-registered
LOG_LEVEL=info                    # debug | info | warn | error
REQUEST_TIMEOUT_MS=20000          # HTTP request timeout

# HTTP auth — use at least one of: static Bearer key and/or OAuth (for Claude connectors)
MCP_ACCESS_API_KEY=               # Static Bearer for Cursor/OpenClaw (min 16 chars). Generate: openssl rand -hex 32

# OAuth for Claude custom connectors (requires all three when enabled)
MCP_PUBLIC_URL=                   # Public HTTPS base, e.g. https://mcp.yourdomain.com (no trailing slash)
OAUTH_JWT_SECRET=                 # HS256 signing key (min 32 chars). Generate: openssl rand -hex 32
OAUTH_CONSENT_PASSWORD=           # Password shown on /oauth/authorize consent page
OAUTH_ACCESS_TOKEN_TTL_SECONDS=86400   # Access token lifetime (default 24h)
OAUTH_CODE_TTL_SECONDS=600             # Authorization code lifetime (default 10 min)
OAUTH_REFRESH_TOKEN_TTL_SECONDS=7776000  # Refresh token lifetime (default 90 days)
OAUTH_DATA_DIR=/data                   # OAuth client persistence (Docker volume mount)

# Docker Compose only (not read by the Node app)
CLOUDFLARE_TUNNEL_TOKEN=          # From Cloudflare Zero Trust → Tunnels → Docker install
